{
  "name": "board-gamer",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "supabase": "npx --yes supabase@2.122.0",
    "test:integration": "node --env-file=.env.integration.local node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.ts$"
    ],
    "moduleNameMapper": {
      "^@(model|controller|view)$": "<rootDir>/src/$1",
      "^@(model|controller|view)/(.*)$": "<rootDir>/src/$1/$2"
    }
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.19",
    "expo-font": "~58.0.11",
    "expo-notifications": "~58.1.8",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "private": true
}
